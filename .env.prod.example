# ===========================================
# 프로덕션 환경 변수 (AWS EC2)
# ===========================================
# 복사: cp .env.prod.example .env
# 편집: nano .env

# App Configuration
APP_NAME=White-Black Developer
DEBUG=false
LOG_LEVEL=INFO

# Database (반드시 변경!)
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_NAME=whiteblack

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# GitHub OAuth (https://github.com/settings/developers)
# Callback URL은 실제 도메인 또는 EC2 IP로 설정
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/api/v1/auth/github/callback

# JWT Authentication (반드시 변경!)
# 생성: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Encryption (반드시 변경!)
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_THIS_32_BYTE_FERNET_KEY

# AI 모델 설정 (수정 불필요)
CODE_REVIEWER_MODEL=microsoft/codereviewer
VULNERABILITY_DETECTOR_MODEL=mahdin70/codebert-devign-code-vulnerability-detector
PERSONA_MODEL=beomi/Llama-3-Open-Ko-8B-Instruct-preview

# 모델 캐시 (Docker 볼륨 사용)
HF_HOME=/app/model_cache
TRANSFORMERS_CACHE=/app/model_cache

# GPU 설정
CUDA_VISIBLE_DEVICES=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
