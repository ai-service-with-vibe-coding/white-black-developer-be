# ================================================
# 흑백개발자 환경 설정
# ================================================
# MVP 모드: APP, AI 모델 설정, GPU 설정만 필요
# 전체 기능: 모든 설정 필요

# App Configuration (MVP 필수)
APP_NAME=White-Black Developer
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/whiteblack

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# GitHub OAuth
# https://github.com/settings/developers 에서 OAuth App 생성
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# AI 모델 설정 (로컬 GPU 실행)
# OpenAI API나 Hugging Face API key는 필요 없음!
CODE_REVIEWER_MODEL=microsoft/codereviewer
VULNERABILITY_DETECTOR_MODEL=mahdin70/codebert-devign-code-vulnerability-detector
PERSONA_MODEL=beomi/OPEN-SOLAR-KO-10.7B

# 대안 페르소나 모델 (메모리 부족 시)
# PERSONA_MODEL=beomi/llama-2-ko-7b
# PERSONA_MODEL=yanolja/EEVE-Korean-Instruct-10.8B-v1.0

# 모델 캐시 디렉토리
# 모델은 처음 실행 시 Hugging Face Hub에서 자동 다운로드됨
HF_HOME=./model_cache
TRANSFORMERS_CACHE=./model_cache

# GPU 설정
# 사용할 GPU ID (0, 1, 2, ...) - 여러 GPU가 있는 경우
CUDA_VISIBLE_DEVICES=0

# Encryption
# 32 bytes 키 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-encryption-key-for-fernet

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=INFO
